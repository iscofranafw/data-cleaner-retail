# ==============================================================================
# Olsera Data Cleaner — Environment Variables Template (.env.example)
# DO NOT PUT REAL CREDENTIALS IN THIS TEMPLATE FILE.
# Copy this file to .env for local development and fill with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Olsera API Credentials
# ------------------------------------------------------------------------------
OLSERA_APP_ID=your_olsera_app_id_here
OLSERA_SECRET_KEY=your_olsera_secret_key_here
OLSERA_BASE_URL=https://api-open.olsera.co.id/api/open-api/v1
OLSERA_PAGE_SIZE=50
OLSERA_TIMEOUT_SECONDS=30
OLSERA_EXPECTED_STORE_ID=your_expected_store_id_here

# ------------------------------------------------------------------------------
# Security & Operational Controls
# ------------------------------------------------------------------------------
# Strict Read-Only default. Set to YES ONLY for controlled local testing.
OLSERA_ENABLE_UPDATES=NO
IS_CLOUD_DEPLOYMENT=false

# ------------------------------------------------------------------------------
# Authentication & Authorization (Server-Side Allowlist & RBAC)
# ------------------------------------------------------------------------------
# Set AUTH_ENABLED=true for production / cloud deployments.
AUTH_ENABLED=false
# Comma-separated list of authorized email addresses
ALLOWED_EMAILS=owner@yourstore.com,auditor@yourstore.com,operator@yourstore.com
# Role mappings: email:role (roles: admin, operator, auditor, viewer)
USER_ROLES={"owner@yourstore.com": "admin", "operator@yourstore.com": "operator", "auditor@yourstore.com": "auditor"}

# ------------------------------------------------------------------------------
# Database Persistence (Local SQLite vs Cloud PostgreSQL/Supabase)
# ------------------------------------------------------------------------------
# Leave empty for local SQLite (stored in OLSERA_DATA_DIR/database/olsera_cleaner.db)
# For cloud, provide standard PostgreSQL / Supabase connection URI:
DATABASE_URL=
# Example: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# Local storage directory (ignored when DATABASE_URL is set)
OLSERA_DATA_DIR=

# ------------------------------------------------------------------------------
# AI Provider Configuration (Ollama, OpenAI Compatible, Gemini, Disabled)
# ------------------------------------------------------------------------------
AI_PROVIDER=OLLAMA
AI_ENDPOINT=http://127.0.0.1:11434
AI_MODEL_NAME=llama3:8b
AI_API_KEY=
# Crucial privacy guardrail: do NOT transmit product data to external AI without explicit consent
ALLOW_EXTERNAL_AI_DATA_SHARING=false
