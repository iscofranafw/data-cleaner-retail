# ==============================================================================
# Streamlit Community Cloud — Secrets Template (.streamlit/secrets.toml.example)
# DO NOT COMMIT REAL SECRETS. On Streamlit Community Cloud, enter these in:
# App Settings -> Secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Olsera API Credentials
# ------------------------------------------------------------------------------
OLSERA_APP_ID = "your_olsera_app_id"
OLSERA_SECRET_KEY = "your_olsera_secret_key"
OLSERA_BASE_URL = "https://api-open.olsera.co.id/api/open-api/v1"
OLSERA_PAGE_SIZE = 50
OLSERA_TIMEOUT_SECONDS = 30
OLSERA_EXPECTED_STORE_ID = "your_store_id"

# ------------------------------------------------------------------------------
# Cloud Security & Safety (Strict Read-Only)
# ------------------------------------------------------------------------------
IS_CLOUD_DEPLOYMENT = true
OLSERA_ENABLE_UPDATES = "NO"
ALLOW_CLOUD_LIVE_UPDATES = "NO"

# ------------------------------------------------------------------------------
# Authentication & Authorization (Private App Gate)
# ------------------------------------------------------------------------------
AUTH_ENABLED = true
# Comma-separated list of allowed user emails
ALLOWED_EMAILS = "owner@yourstore.com,auditor@yourstore.com,operator@yourstore.com"

# Role Mapping (admin, operator, auditor, viewer)
[USER_ROLES]
"owner@yourstore.com" = "admin"
"operator@yourstore.com" = "operator"
"auditor@yourstore.com" = "auditor"

# ------------------------------------------------------------------------------
# Database Configuration (Stateless Cloud Mode - No Supabase required)
# ------------------------------------------------------------------------------
# In Stateless Cloud Mode, leave DATABASE_URL commented out or empty.
# Ephemeral SQLite is automatically created and wiped on restart.
# Products can be synced on-demand via API or restored from ZIP backup.
# Optional future persistent database (Supabase/PostgreSQL):
# DATABASE_URL = "postgresql://postgres.xxxx:your_db_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# ------------------------------------------------------------------------------
# AI Provider Configuration
# ------------------------------------------------------------------------------
# Options: "OLLAMA" (if self-hosted VPN/tunnel), "OPENAI_COMPATIBLE", "GEMINI", "DISABLED"
AI_PROVIDER = "DISABLED"
AI_ENDPOINT = ""
AI_MODEL_NAME = ""
AI_API_KEY = ""
# Data Privacy Gate: set to true ONLY if you explicitly consent to sharing product catalog data with external AI
ALLOW_EXTERNAL_AI_DATA_SHARING = false
